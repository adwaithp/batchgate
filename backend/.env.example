# Copy to backend/.env and adjust.
BATCHGATE_SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars
BATCHGATE_DATABASE_URL=sqlite:///./batchgate.db
BATCHGATE_DEMO_MODE=true

# Claude reads uploaded COAs. Without a key, values are typed in by hand.
ANTHROPIC_API_KEY=
# BATCHGATE_EXTRACTION_MODEL=claude-sonnet-5-5

# The worker (uv run arq app.worker.WorkerSettings) and the progress stream use Redis.
BATCHGATE_REDIS_URL=redis://localhost:6379
