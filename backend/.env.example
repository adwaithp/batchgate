# Copy to backend/.env and adjust.

# PostgreSQL (the only database BatchGate uses)
BATCHGATE_DB_HOST=localhost
BATCHGATE_DB_PORT=5432
BATCHGATE_DB_NAME=batchgate
BATCHGATE_DB_USER=batchgate
BATCHGATE_DB_PASSWORD=
# Or one full URL instead of the parts above (special characters in the password must be %-encoded):
# BATCHGATE_DATABASE_URL=postgresql+psycopg://batchgate:secret@localhost:5432/batchgate

BATCHGATE_SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars
BATCHGATE_DEMO_MODE=true

# Claude reads uploaded COAs and writes the copilot's briefs. Without a key, values are typed in by hand.
ANTHROPIC_API_KEY=
# BATCHGATE_EXTRACTION_MODEL=claude-sonnet-5-5

# The worker (uv run arq app.worker.WorkerSettings) and the progress stream use Redis.
BATCHGATE_REDIS_URL=redis://localhost:6379
