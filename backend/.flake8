[flake8]
max-line-length = 99
max-complexity = 15
# E203 and W503 conflict with the formatter's (PEP 8 compliant) slicing and line breaks.
extend-ignore = E203, W503
exclude = .venv, __pycache__, .pytest_cache, .ruff_cache, uploads
# Mirrors the ruff per-file settings: embedded document text, and settings set before imports.
per-file-ignores =
    app/seed.py: E501
    app/seed_knowledge.py: E501
    tests/conftest.py: E402
    ../evals/run_*.py: E402
    ../evals/generate_coas.py: E402, E501
    ../evals/run_copilot.py: E402, E501
