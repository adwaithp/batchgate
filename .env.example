# Settings for docker compose (docker-compose.yml). Copy to .env and fill in.
# Generate secrets with:  openssl rand -hex 32
# A literal $ in a value must be written as $$ (compose reads $ as a variable).

# The PostgreSQL database the db service creates on first start, and the api and worker use.
BATCHGATE_DB_NAME=batchgate
BATCHGATE_DB_USER=batchgate
BATCHGATE_DB_PASSWORD=change-me

BATCHGATE_SECRET_KEY=change-me-to-a-long-random-string

# Claude reads COAs and writes the copilot's briefs. Without it, values are typed in by hand.
ANTHROPIC_API_KEY=

# Optional: a domain whose DNS A record points at this server, for automatic HTTPS.
DOMAIN=

# true shows one-click demo logins on the sign-in page. Set false for anything real.
BATCHGATE_DEMO_MODE=true
